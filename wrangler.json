{
  "name": "murmur-services-v7",
  "main": "src/index.js",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "SHARDS",
        "class_name": "DataShard"
      },
      {
        "name": "COORDINATOR",
        "class_name": "Coordinator"
      },
      {
        "name": "SCHEMA",
        "class_name": "SchemaManager"
      },
      {
        "name": "ALLOCATOR",
        "class_name": "PlanAllocator"
      },
      {
        "name": "MEDIATORS",
        "class_name": "PlanBucket"
      },
      {
        "name": "CURSORS",
        "class_name": "QueryCursor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v7-initial",
      "new_sqlite_classes": [
        "DataShard",
        "PlanAllocator",
        "PlanBucket",
        "Coordinator",
        "SchemaManager",
        "QueryCursor"
      ]
    }
  ],
  "vars": {
