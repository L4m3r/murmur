+    fn metadata(&self, prefix: Option<&Path>) -> object_store::Result<Vec<StoredObject>> {
+        // ObjectStore prefixes match whole path components, not raw strings.
+        // Every descendant of a nonempty prefix is in [prefix + "/", prefix + "0")
