{
  "name": "actor-row-db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:integration": "node scripts/integration.mjs",
    "dev": "node scripts/dev.mjs",
    "setup:celld": "CELLD_VERSION=v0.6.3 CELLD_INSTALL_ROOT=\"$PWD/.tools\" sh scripts/install-celld.sh",
    "test:e2e": "bash scripts/test-celld.sh",
    "test:storage": "bash scripts/test-storage.sh",
    "setup:moto": "python3 -m venv .tools/moto && .tools/moto/bin/python -m pip install --disable-pip-version-check 'moto[server]==5.1.15'",
    "test:fleet": "bash scripts/test-fleet.sh",
    "test:retention": "bash scripts/test-retention.sh",
    "test:composite": "bash scripts/test-composite.sh",
    "test:online-index": "bash scripts/test-online-index.sh",
    "maintenance": "node scripts/maintenance.mjs",
    "test:query-pagination": "bash scripts/test-query-pagination.sh",
    "benchmark:protocol": "node scripts/benchmark-protocol.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:coordinator-pool": "bash scripts/test-coordinator-pool.sh && POOL_TEST_MODE=transactions bash scripts/test-coordinator-pool.sh",
    "test:observability": "bash scripts/test-observability.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright-core": "1.62.1"
  }
}
